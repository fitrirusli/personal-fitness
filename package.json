{
  "name": "personal-fitness-web",
  "private": true,
  "author": "fitrirusli",
  "license": "UNLICENSED",
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build && node scripts/create-sw.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "node .private/android-tools/build.mjs sync",
    "android:apk": "node .private/android-tools/build.mjs apk",
    "format": "prettier --write src tests scripts/*.mjs *.js *.json docs/*.md README.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts/*.mjs *.js *.json docs/*.md README.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.548.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
